{
  "version": "1.0.0",
  "templates": {
    "startup-mvp": {
      "id": "startup-mvp",
      "name": "Startup MVP",
      "description": "Minimal viable documentation for small teams shipping fast",
      "ideal_team": [1, 3],
      "ideal_files": [0, 50],
      "complexity": "low",
      "has_compliance_sections": false,
      "has_ai_sections": false,
      "documents": [
        { "path": "docs/PRD.md", "required": true, "template": "startup-prd" },
        { "path": "docs/API.md", "required": false, "template": "api-reference" },
        { "path": "docs/ARCHITECTURE.md", "required": true, "template": "adr" },
        { "path": "docs/GLOSSARY.md", "required": false, "template": "glossary" }
      ],
      "requirement_id_scheme": ["FR", "NFR"],
      "standards": []
    },
    "3layer-appendix": {
      "id": "3layer-appendix",
      "name": "3-Layer + Appendix",
      "description": "Balanced structure with PRD (Layer 1), SDD (Layer 2), optional AI (Layer 3), and 6 appendices",
      "ideal_team": [4, 15],
      "ideal_files": [50, 500],
      "complexity": "medium",
      "has_compliance_sections": false,
      "has_ai_sections": true,
      "documents": [
        { "path": "docs/PRD-SDD-v1.0.md", "required": true, "template": "3layer-main" },
        { "path": "docs/appendices/A-api-spec.md", "required": true, "template": "api-appendix" },
        { "path": "docs/appendices/B-db-schema.md", "required": true, "template": "db-appendix" },
        { "path": "docs/appendices/C-model-cards.md", "required": false, "template": "model-cards" },
        { "path": "docs/appendices/D-traceability.md", "required": true, "template": "traceability" },
        { "path": "docs/appendices/E-risk-matrix.md", "required": true, "template": "risk-matrix" },
        { "path": "docs/appendices/F-glossary.md", "required": true, "template": "glossary" },
        { "path": "docs/ARCHITECTURE.md", "required": true, "template": "adr" },
        { "path": "docs/CONTRIBUTING.md", "required": false, "template": "contributing" },
        { "path": "docs/frontend-design-system.md", "required": false, "template": "design-system" },
        { "path": "docs/api/README.md", "required": false, "template": "api-guide" }
      ],
      "requirement_id_scheme": ["FR", "NFR", "SDD", "SEC", "AI-AGT", "AI-ETH", "BR", "AC"],
      "standards": ["IEEE 29148-2018", "IEEE 1016-2009"]
    },
