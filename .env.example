# Secure defaults: local browser only until trusted HTTPS is configured.
OLLAMA_CENTER_PORT=4173
RWANG_HOST=127.0.0.1
RWANG_ALLOW_INSECURE_LAN=0

# Direct trusted HTTPS for phone/LAN access (uncomment and use real local paths).
# RWANG_PUBLIC_ORIGIN never upgrades proxy/plaintext HTTP; pairing requires native TLS.
# RWANG_HOST=0.0.0.0
# RWANG_TLS_CERT_FILE=certs/rwang-cert.pem
# RWANG_TLS_KEY_FILE=certs/rwang-key.pem
# RWANG_TLS_PFX_FILE=
# RWANG_TLS_PASSPHRASE=
# RWANG_PUBLIC_ORIGIN=https://192.168.1.50:4173
# RWANG_ALLOWED_HOSTS=rwang.home.arpa:4173

# Optional STUN/TURN. Prefer short-lived TURN credentials in production.
# RWANG_ICE_SERVERS_JSON=[{"urls":"stun:stun.example.net:3478"},{"urls":"turns:turn.example.net:5349","username":"RWANG","credential":"CHANGE_ME"}]
