# Secure defaults: local browser only until trusted HTTPS is configured.
OLLAMA_CENTER_PORT=4173
RWANG_HOST=127.0.0.1
RWANG_ALLOW_INSECURE_LAN=0

# Runtime roots. RESOURCE and CAPABILITY are read-only inputs; DATA contains
# mutable config, queue state, fingerprints and logs. All configured paths must
# be absolute. DATA must stay separate from RESOURCE and WORKSPACE.
# Defaults: RESOURCE and WORKSPACE are this package; DATA is
# %LOCALAPPDATA%\\RWANG\\data (or ~/.rwang/data); CAPABILITY is the bundled
# capabilities/rwang-document-intelligence directory under RESOURCE.
# RWANG_RESOURCE_DIR=C:\\Users\\you\\workspace\\rwang-local-assistant
# RWANG_DATA_DIR=C:\\Users\\you\\AppData\\Local\\RWANG\\data
# RWANG_WORKSPACE_DIR=C:\\Users\\you\\workspace\\my-project
# RWANG_CAPABILITY_DIR=C:\\Users\\you\\workspace\\rwang-local-assistant\\capabilities\\rwang-document-intelligence
# On the first startup after this split, the server copy-migrates only these
# stable legacy files from RESOURCE_DIR when the matching DATA_DIR file is
# absent: .rwang-config.json, .rwang-tool-fingerprints.json, .queue-state.json,
# and rwang.log. It never scans/globs, overwrites, or deletes source data.

# Local-only Spotlight filename index. Defaults to Desktop, Documents, Downloads,
# Pictures, Music, Videos, and this RWANG workspace. On Windows, separate custom
# absolute folders with `;`. Roots must remain under the current user profile.
# RWANG_SPOTLIGHT_ROOTS=C:\Users\you\Documents;C:\Users\you\Pictures
# RWANG_SPOTLIGHT_MAX_FILES=50000
# RWANG_SPOTLIGHT_REFRESH_MS=300000

# Direct trusted HTTPS for phone/LAN access (uncomment and use real local paths).
# RWANG_PUBLIC_ORIGIN never upgrades proxy/plaintext HTTP; pairing requires native TLS.
# RWANG_HOST=0.0.0.0
# RWANG_TLS_CERT_FILE=certs/rwang-cert.pem
# RWANG_TLS_KEY_FILE=certs/rwang-key.pem
# RWANG_TLS_PFX_FILE=
# RWANG_TLS_PASSPHRASE=
# RWANG_PUBLIC_ORIGIN=https://192.168.1.50:4173
# RWANG_ALLOWED_HOSTS=rwang.home.arpa:4173

# Optional STUN/TURN. Prefer short-lived TURN credentials in production.
# RWANG_ICE_SERVERS_JSON=[{"urls":"stun:stun.example.net:3478"},{"urls":"turns:turn.example.net:5349","username":"RWANG","credential":"CHANGE_ME"}]
